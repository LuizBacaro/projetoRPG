# Variáveis de ambiente — NUNCA commitar
.env

# Banco local
*.db

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Uploads locais
uploads/
backend/uploads/
backend/uploads/**
*.pdf

# IDE
.vscode/
.idea/

# Scripts: artefatos gerados em runtime (não versionar)
backend/scripts/generated/

# Assets binários gerados: manter apenas CSVs de referência, não JSONs grandes
backend/scripts/assets/*.json
backend/scripts/assets/*.xlsx

# Backups e dumps de banco — nunca versionar (podem conter credenciais)
*.dump
*.sql.gz
*.backup
*_backup.sql
*_backup.dump
*_producao_*.json
neon_*.dump

# Scripts temporários de sessão
tmp_*.py
tmp_*.sh

# Temp de validacao e runners
/tmp/*.copilot.*