{
  "version": 2,
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/",              "dest": "/frontend/pages/login.html" },
    { "src": "/arena",         "dest": "/frontend/index.html" },
    { "src": "/pages/(.*)",    "dest": "/frontend/pages/$1" },
    { "src": "/css/(.*)",      "dest": "/frontend/css/$1" },
    { "src": "/js/(.*)",       "dest": "/frontend/js/$1" },
    { "src": "/sw.js",         "dest": "/frontend/sw.js" },
    { "src": "/(.*)",          "dest": "/frontend/$1" }
  ]
}
