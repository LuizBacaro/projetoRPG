{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "node scripts/inject-render-api-origin.cjs",
  "installCommand": "echo 'static'",
  "outputDirectory": "frontend",
    "rewrites": [
    { "source": "/dashboard", "destination": "/games/dnd35/pages/dashboard.html" },
    { "source": "/pericias", "destination": "/games/dnd35/pages/pericias.html" },
    { "source": "/arena", "destination": "/games/dnd35/arena.html" },
    { "source": "/tormenta/dashboard", "destination": "/games/tormenta/pages/dashboard.html" }
  ]
}
