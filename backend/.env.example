# ============================================================
# Arena de Combate RPG — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
# ============================================================

# ── Projeto ──────────────────────────────────────────────────
PROJECT_NAME=Arena de Combate TTRPG API
VERSION=1.0.0
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
# Render Web Service (produção): use ENVIRONMENT=production neste serviço; crie outro serviço
# ou branch preview para staging com ENVIRONMENT=staging. Cada ambiente = DATABASE_URL e SECRET_KEY próprios.
# O Render injeta RENDER=true — com SQLite, a API falha ao subir (proposital).

# ── Segurança ────────────────────────────────────────────────
# OBRIGATÓRIO em produção. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Em desenvolvimento, se vazio, será gerada automaticamente.
SECRET_KEY=

# ── Admin padrão (criado no primeiro startup) ────────────────
# Se vazio, admin NÃO será criado automaticamente.
ADMIN_EMAIL=admin@arena-rpg.com.br
ADMIN_PASSWORD=TroquePorSenhaForte123!
ADMIN_USERNAME=Administrador

# ── Banco de dados ───────────────────────────────────────────
# Dev local (SQLite):
DATABASE_URL=sqlite:///./rpg_arena.db
# Produção Neon (copie a "Connection string" do painel Neon → Connection Details):
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Checklist mínimo no Render (serviço de API):
#   ENVIRONMENT=production
#   DATABASE_URL=postgresql://... (branch Neon de produção; nunca SQLite)
#   SECRET_KEY=<hex 64 chars, único deste serviço>
#   ADMIN_EMAIL= / ADMIN_PASSWORD= (primeiro admin)
#   ALLOWED_ORIGINS=["https://..."]  (sem * em produção)
#
# Catálogo de magias (grimório): com SQLite vazio, o primeiro startup popula automaticamente.
# Em PostgreSQL vazio, defina uma vez: SEED_MAGIAS_ON_EMPTY=1
# ou rode manualmente: cd backend && python scripts/seed_magias.py
# SEED_MAGIAS_ON_EMPTY=0
# Consumíveis (poções/óleos/pergaminhos): em produção, defina false para não subir pergaminhos no seed.
# Padrão true = catálogo completo (igual ao dev).
# CONSUMIVEIS_SEED_PERGAMINHOS=true
# Alembic no startup da app (normalmente 0 em produção quando Procfile já roda upgrade).
# STARTUP_RUN_ALEMBIC=0
#
# Frontend multi-jogo: autoentrada no último jogo válido ao abrir o seletor.
# AUTO_ENTER_LAST_GAME=1

# ── CORS (origens permitidas) ────────────────────────────────
# JSON array de URLs. Em produção, listar domínios explícitos.
# Frontend no Vercel + domínio próprio via Registro.br:
ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]
# Produção (Render): incluir apex e www se o frontend usar ambos.
# ALLOWED_ORIGINS=["https://arena-de-combate-rpg.com.br","https://www.arena-de-combate-rpg.com.br","https://seu-app.vercel.app"]
# Nota: com ENVIRONMENT=production, o backend também acrescenta automaticamente apex + www de
# arena-de-combate-rpg.com.br se ainda não estiverem na lista (evita CORS só no subdomínio www).

# ── Upload ───────────────────────────────────────────────────
MAX_FILE_SIZE=5242880
MAX_REQUEST_SIZE=6291456
MAX_JSON_BODY_SIZE=1048576
# Formato JSON para set/list complexos no pydantic-settings
ALLOWED_EXTENSIONS=[".jpg",".jpeg",".png",".gif",".webp"]

# ── Compressão HTTP (gzip) ──────────────────────────────────
GZIP_ENABLED=true
GZIP_MINIMUM_SIZE=1000

# ── Cache de leitura (catálogos) ────────────────────────────
CACHE_ENABLED=true
CACHE_CATALOG_TTL_SECONDS=300

# ── Rate limiting e sessão ───────────────────────────────────
RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=180
LOGIN_RATE_LIMIT_PER_MINUTE=10
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Caminhos (opcional sobrescrever) ─────────────────────────
# BASE_DIR=.
# FRONTEND_DIR=../frontend
UPLOADS_DIR=./uploads
# URL pública base para arquivos enviados (pode apontar para CDN)
# Ex.: /uploads  |  https://cdn.seudominio.com/uploads
UPLOADS_BASE_URL=/uploads