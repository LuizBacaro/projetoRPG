# ============================================================
# Arena de Combate RPG — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
# ============================================================

# ── Projeto ──────────────────────────────────────────────────
PROJECT_NAME=Arena RPG
VERSION=1.0.0
ENVIRONMENT=development

# ── Segurança ────────────────────────────────────────────────
# OBRIGATÓRIO em produção. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Em desenvolvimento, se vazio, será gerada automaticamente.
SECRET_KEY=

# ── Admin padrão (criado no primeiro startup) ────────────────
# Se vazio, admin NÃO será criado automaticamente.
ADMIN_EMAIL=admin@arena-rpg.com.br
ADMIN_PASSWORD=TroquePorSenhaForte123!
ADMIN_USERNAME=Administrador

# ── Banco de dados ───────────────────────────────────────────
# Dev local (SQLite):
DATABASE_URL=sqlite:///./rpg_arena.db
# Produção Railway (Railway injeta automaticamente):
# DATABASE_URL=postgresql://user:pass@host:port/db

# ── CORS (origens permitidas) ────────────────────────────────
# JSON array de URLs. Em produção, listar domínios explícitos.
ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]

# ── Upload ───────────────────────────────────────────────────
UPLOADS_DIR=./uploads